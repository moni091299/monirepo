					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[sp_DataLoadLog]",
					"storedProcedureParameters": {
						"FileName": {
							"value": {
								"value": "AdventureWorks_Product_Categories.csv",
								"type": "Expression"
							},
							"type": "String"
						},
