							"value": {
								"value": "Success",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase_link",
					"type": "LinkedServiceReference"
				}
			},
